# IDEAZ Messenger - Windows/Node server configuration
# Is file ki copy bana kar naam `.env` rakhein.

APP_NAME=IDEAZ Messenger
NODE_ENV=production
PORT=3000

# Neon/Bonto se poori postgresql:// connection string yahan paste karein.
DATABASE_URL=PASTE_COMPLETE_POSTGRESQL_URL_HERE

# Kam az kam 32 characters ka naya random secret banayein.
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Upload limit bytes mein: 104857600 = 100 MB per file.
MAX_UPLOAD_SIZE=104857600

# Metered TURN details (door/mobile-network audio-video calls ke liye).
# Multiple URLs comma se separate kiye ja sakte hain.
TURN_URLS=PASTE_METERED_TURN_URLS_HERE
TURN_USERNAME=PASTE_METERED_USERNAME_HERE
TURN_CREDENTIAL=PASTE_METERED_CREDENTIAL_HERE
