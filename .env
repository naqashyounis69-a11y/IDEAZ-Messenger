########################################
# IDEAZ Messenger Configuration
########################################

########################################
# Application
########################################

APP_NAME=IDEAZ Messenger
NODE_ENV=development
PORT=3001

APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

########################################
# PostgreSQL Database
########################################

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ideaz_messenger
DB_USER=postgres
DB_PASSWORD=Ideaz2026
OUR_POSTGRES_PASSWORD=Ideaz2026

DATABASE_URL="postgresql://postgres:Ideaz2026@localhost:5432/ideaz_messenger?schema=public"

########################################
# JWT Authentication
########################################

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=30d

JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_LONG_ACCESS_TOKEN_SECRET
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_LONG_REFRESH_TOKEN_SECRET
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_ROUNDS=12

########################################
# Family Access
########################################

FAMILY_CODE=IDEAZFAMILY2026

########################################
# Upload Directories
########################################

UPLOAD_PATH=uploads
AVATAR_PATH=uploads/avatars
IMAGE_PATH=uploads/images
FILE_PATH=uploads/files
VOICE_PATH=uploads/voice

########################################
# File Upload Limits
########################################

MAX_FILE_SIZE=104857600

ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,gif
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,zip,rar,txt
ALLOWED_AUDIO_TYPES=mp3,wav,ogg,m4a

########################################
# Default Profile
########################################

DEFAULT_ABOUT=Hey! I am using IDEAZ Messenger
DEFAULT_AVATAR=default.png

########################################
# Admin
########################################

ADMIN_USERNAME=admin
ADMIN_PIN=CHANGE_ADMIN_PIN

########################################
# Production Domain
########################################

DOMAIN=ideazchat.duckdns.org
VPS_UPLOAD_PATH=/var/www/ideaz/uploads